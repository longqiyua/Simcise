{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Simcise Design Tokens — AI-executable constraint system",
  "meta": {
    "version": "2.3.0",
    "license": "MIT"
  },

  "color": {
    "bg": {
      "default": { "value": "#FAFAF8", "type": "color", "description": "Page background" },
      "secondary": { "value": "#F5F5F0", "type": "color", "description": "Warm secondary BG" },
      "tertiary": { "value": "#EEEBE6", "type": "color", "description": "Tertiary BG / inactive" },
      "surface": { "value": "#FFFFFF", "type": "color", "description": "Card surface (only pure white)" }
    },
    "text": {
      "primary": { "value": "#1A1A1A", "type": "color" },
      "secondary": { "value": "#666666", "type": "color" },
      "muted": { "value": "#999999", "type": "color" },
      "faint": { "value": "#AAAAAA", "type": "color" }
    },
    "border": {
      "default": { "value": "#E5E5E5", "type": "color" },
      "warm": { "value": "#D8D6D0", "type": "color" },
      "strong": { "value": "#D4D4D8", "type": "color" }
    },
    "accent": {
      "50": { "value": "#E8F0EF", "type": "color", "description": "Mist — selection bg" },
      "100": { "value": "#C5DDD9", "type": "color", "description": "Foam — tag border" },
      "200": { "value": "#8FBFB8", "type": "color", "description": "Tide — hover bg" },
      "300": { "value": "#5A9E96", "type": "color", "description": "Reef — link hover" },
      "400": { "value": "#3D857E", "type": "color", "description": "Kelp — secondary btn" },
      "core": { "value": "#1A6B66", "type": "color", "description": "★ Core — primary actions" },
      "600": { "value": "#145551", "type": "color", "description": "Deep — pressed state" },
      "700": { "value": "#0E3F3C", "type": "color", "description": "Abyss — text on light" }
    },
    "semantic": {
      "danger": { "value": "#D94F4F", "type": "color", "description": "Danger only — NEVER accent" },
      "success": { "value": "#059669", "type": "color" },
      "warning": { "value": "#F59E0B", "type": "color" },
      "info": { "value": "#3B82F6", "type": "color" }
    },
    "dark": {
      "bg": { "value": "#16171A", "type": "color" },
      "surface": { "value": "#1C1D21", "type": "color" },
      "accent": { "value": "#2A8D84", "type": "color" },
      "text": { "value": "#DDE3EB", "type": "color" }
    }
  },

  "spacing": {
    "unit": { "value": "4px", "type": "dimension", "description": "Base unit — all values must be multiples" },
    "xs": { "value": "4px", "type": "dimension" },
    "sm": { "value": "8px", "type": "dimension" },
    "md": { "value": "12px", "type": "dimension" },
    "lg": { "value": "16px", "type": "dimension" },
    "xl": { "value": "24px", "type": "dimension" },
    "2xl": { "value": "32px", "type": "dimension" },
    "3xl": { "value": "48px", "type": "dimension" }
  },

  "borderRadius": {
    "sm": { "value": "8px", "type": "dimension", "description": "Minimum radius" },
    "input": { "value": "10px", "type": "dimension" },
    "btn": { "value": "12px", "type": "dimension" },
    "card": { "value": "14px", "type": "dimension" },
    "np": { "value": "18px", "type": "dimension", "description": "Now Playing card" },
    "xl": { "value": "20px", "type": "dimension" },
    "pill": { "value": "999px", "type": "dimension" }
  },

  "shadow": {
    "sm": { "value": "0 2px 8px rgba(0,0,0,0.08)", "type": "shadow" },
    "md": { "value": "0 4px 16px rgba(0,0,0,0.12)", "type": "shadow" },
    "lg": { "value": "0 8px 32px rgba(0,0,0,0.18)", "type": "shadow" },
    "xl": { "value": "0 24px 64px rgba(0,0,0,0.35)", "type": "shadow" }
  },

  "typography": {
    "fontFamily": {
      "latin": { "value": "'Nunito', -apple-system, sans-serif", "type": "fontFamily" },
      "cjk": { "value": "'Source Han Sans SC', 'Noto Sans SC', sans-serif", "type": "fontFamily" },
      "mono": { "value": "'JetBrains Mono', 'SF Mono', monospace", "type": "fontFamily" },
      "display": { "value": "'Outfit', 'Nunito', sans-serif", "type": "fontFamily" }
    },
    "fontSize": {
      "base": { "value": "13px", "type": "dimension", "description": "Global base font size" },
      "xs": { "value": "11px", "type": "dimension" },
      "sm": { "value": "12px", "type": "dimension" },
      "md": { "value": "14px", "type": "dimension" },
      "lg": { "value": "16px", "type": "dimension" },
      "xl": { "value": "20px", "type": "dimension" },
      "2xl": { "value": "24px", "type": "dimension" },
      "3xl": { "value": "32px", "type": "dimension" }
    },
    "lineHeight": {
      "base": { "value": "1.55", "type": "number", "description": "Global base line height" },
      "cjk": { "value": "1.65", "type": "number", "description": "CJK adds +0.1 for readability" }
    }
  },

  "motion": {
    "duration": {
      "micro": { "value": "150ms", "type": "duration", "description": "hover, focus" },
      "enter": { "value": "200ms", "type": "duration", "description": "element show/hide" },
      "panel": { "value": "300ms", "type": "duration", "description": "panel expand/collapse" },
      "morph": { "value": "400ms", "type": "duration", "description": "shape deformation" },
      "breath": { "value": "4000ms", "type": "duration", "description": "breathing animation cycle" }
    },
    "easing": {
      "main": { "value": "cubic-bezier(0.4, 0, 0.2, 1)", "type": "cubicBezier", "description": "80% of all transitions" },
      "enter": { "value": "cubic-bezier(0.22, 0.95, 0.35, 1)", "type": "cubicBezier" },
      "bounce": { "value": "cubic-bezier(0.22, 1.2, 0.36, 1)", "type": "cubicBezier" },
      "exit": { "value": "cubic-bezier(0.4, 0, 0.6, 0.9)", "type": "cubicBezier" }
    }
  },

  "blur": {
    "light": { "value": "10px", "type": "dimension", "description": "Tooltip, floating card" },
    "medium": { "value": "16px", "type": "dimension", "description": "Context menu, dropdown" },
    "heavy": { "value": "32px", "type": "dimension", "description": "Modal overlay" },
    "extreme": { "value": "48px", "type": "dimension", "description": "Immersive background" }
  },

  "constraints": {
    "accentAreaPercent": { "value": 15, "type": "number", "description": "Max accent color visual weight %" },
    "maxRadiusVariants": { "value": 3, "type": "number", "description": "Max different radius values per view" },
    "maxShadowLayers": { "value": 2, "type": "number", "description": "Max shadow layers stacked" },
    "spacingMultiple": { "value": 4, "type": "number", "description": "All spacing must be multiples of" },
    "colorMixStep": { "value": 5, "type": "number", "description": "color-mix() percentage step" }
  }
}
